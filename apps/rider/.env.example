# Copy to ".env" in this folder to connect the Rider app to live data.
# Without these, the app runs in DEMO_MODE (login: demo / demo).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Rider's UPI ID — used to show a UPI QR so customers can pay COD orders online.
EXPO_PUBLIC_UPI_VPA=yourname@upi

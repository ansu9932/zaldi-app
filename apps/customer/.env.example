# Copy to ".env" in this folder to connect live data.
# Without these, the app runs in DEMO_MODE with the bundled sample Contai catalog.
# Only PUBLIC keys go here (safe to ship in the app). NEVER put secret keys here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Razorpay publishable KEY ID only (the SECRET stays in Supabase function secrets).
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_live_or_test_xxxxxxxxxxxx

# Optional: real map key + automatic rain fee (OpenWeatherMap).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key
EXPO_PUBLIC_OPENWEATHER_API_KEY=your-openweather-key

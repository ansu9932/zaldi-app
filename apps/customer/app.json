{
  "expo": {
    "name": "next",
    "slug": "next-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nextcustomer",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "runtimeVersion": { "policy": "appVersion" },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.nextapp.customer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "next needs your location to check if delivery is available in your area and to deliver your order."
      }
    },
    "android": {
      "package": "in.nextapp.customer",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "config": {
        "googleMaps": { "apiKey": "YOUR_ANDROID_GOOGLE_MAPS_API_KEY" }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "next needs your location to check delivery availability and deliver your order."
        }
      ],
      [
        "expo-notifications",
        { "color": "#00D16B" }
      ]
    ],
    "extra": {
      "router": { "origin": false }
    }
  }
}
